<Window
    xmlns="https://github.com/avaloniaui"
    x:DataType="vms:RoutingRuleBlocksViewModel"
    x:CompileBindings="False"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    x:Class="v2rayN.Desktop.Views.RoutingRuleBlocksWindow"
    Title="{x:Static resx:ResUI.RoutingBlocksTitle}"
    Width="820"
    Height="760"
    MinWidth="640"
    MinHeight="480"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="RoutingFilterTemplate">
            <StackPanel>
                <TextBlock Text="{x:Static resx:ResUI.RoutingBlocksOr}"
                    IsVisible="{Binding ShowOr}" HorizontalAlignment="Center" Margin="0,8" Opacity="0.7" />
                <TextBlock
                    Text="{x:Static resx:ResUI.RoutingBlocksAnd}"
                    IsVisible="{Binding ShowAnd}"
                    HorizontalAlignment="Center"
                    Margin="0,8"
                    Opacity="0.7" />
                <Border
                    BorderThickness="1"
                    BorderBrush="Gray"
                    CornerRadius="6"
                    Padding="12">
                    <StackPanel>
                        <DockPanel>
                            <Button
                                DockPanel.Dock="Right"
                                Content="×"
                                Command="{Binding RemoveCmd}"
                                Padding="8,2"
                                AutomationProperties.Name="{x:Static resx:ResUI.RoutingBlocksRemove}" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Run Text="{Binding Title}" FontWeight="Bold" /><Run Text=" — " /><Run Text="{Binding Hint}" />
                            </TextBlock>
                        </DockPanel>
                        <TextBox
                            Text="{Binding Text, Mode=TwoWay}"
                            IsVisible="{Binding IsText}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="64"
                            MaxHeight="160"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="{Binding Title}" />
                        <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Content="{Binding Value}"
                                        IsChecked="{Binding Selected, Mode=TwoWay}"
                                        Margin="0,0,16,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel IsVisible="{Binding IsApplications}" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" /><ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" IsVisible="{Binding IsEditable}" />
                                <Button Grid.Column="1" Content="{Binding PackageSortHeading}" Command="{Binding SortPackagesCmd}"
                                    IsVisible="{Binding IsPackages}" HorizontalAlignment="Left" Padding="0" Background="Transparent" BorderThickness="0" />
                                <TextBlock Grid.Column="2" Text="{x:Static resx:ResUI.AppRoutingChildrenColumn}" IsVisible="{Binding HasChildren}" ToolTip.Tip="{Binding Hint}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Applications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="88" /><ColumnDefinition Width="104" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static resx:ResUI.LvEnabled}" />
                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" IsVisible="{Binding IsEditable}" Margin="0,0,8,0" ToolTip.Tip="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" IsVisible="{Binding IsPackage}" Margin="0,0,8,0"
                                                VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}" />
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IncludeChildren, Mode=TwoWay}" IsVisible="{Binding HasChildren}" VerticalAlignment="Center" AutomationProperties.Name="{x:Static resx:ResUI.AppRoutingChildrenColumn}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="↑" Command="{Binding UpCmd}" IsVisible="{Binding IsEditable}" Padding="6,2" AutomationProperties.Name="{x:Static resx:ResUI.RoutingBlocksMoveUp}" />
                                                <Button Content="↓" Command="{Binding DownCmd}" IsVisible="{Binding IsEditable}" Padding="6,2" AutomationProperties.Name="{x:Static resx:ResUI.RoutingBlocksMoveDown}" />
                                                <Button Content="×" Command="{Binding DeleteCmd}" Padding="6,2" AutomationProperties.Name="{x:Static resx:ResUI.RoutingBlocksRemove}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+" Command="{Binding ChooseCmd}" IsEnabled="{Binding CanPickPackages}" IsVisible="{Binding IsPackages}"
                                HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0"
                                AutomationProperties.Name="{x:Static resx:ResUI.AppRoutingChoose}" />
                            <WrapPanel IsVisible="{Binding IsProcess}" Margin="0,8,0,0">
                                <Button Content="{x:Static resx:ResUI.RoutingBlocksFullPath}" Command="{Binding AddFullPathCmd}" Padding="12,4" Margin="0,0,8,0" />
                                <Button Content="{x:Static resx:ResUI.RoutingBlocksFolder}" Command="{Binding AddFolderCmd}" Padding="12,4" Margin="0,0,8,0" />
                                <Button Content="{x:Static resx:ResUI.RoutingBlocksExecutable}" Command="{Binding ChooseCmd}" IsEnabled="{Binding CanPickPackages}" Padding="12,4" />
                            </WrapPanel>
                            <WrapPanel IsVisible="{Binding IsService}" Margin="0,8,0,0">
                                <Button Content="{x:Static resx:ResUI.AppRoutingChooseServices}" Command="{Binding ChooseServicesCmd}"
                                    IsEnabled="{Binding CanPickServices}" Padding="12,4" Margin="0,0,8,0" />
                                <Button Content="{x:Static resx:ResUI.RoutingBlocksAddService}" Command="{Binding AddServiceCmd}" Padding="12,4" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <DockPanel Margin="0,0,0,8">
                <ToggleSwitch
                    DockPanel.Dock="Right"
                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static resx:ResUI.LvEnabled}" />
                <TextBlock Text="{x:Static resx:ResUI.LvRemarks}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="txtRemarks" Text="{Binding Remarks, Mode=TwoWay}" />
            </DockPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static resx:ResUI.TbRuleType}" />
                    <ComboBox
                        x:Name="cmbRuleType"
                        SelectedItem="{Binding RuleType, Mode=TwoWay}"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Static resx:ResUI.RoutingBlocksOutboundTag}" />
                    <ComboBox
                        x:Name="cmbOutboundTag"
                        IsEditable="True"
                        Text="{Binding OutboundTag, Mode=TwoWay}"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Content="{x:Static resx:ResUI.TbSelectProfile}"
                    Command="{Binding SelectProfileCmd}"
                    Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    Padding="12,6" />
            </Grid>
            <TextBlock
                Text="{Binding Expression}"
                TextWrapping="Wrap"
                Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <Border
                    IsVisible="{Binding HasMatches}"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <StackPanel>
                        <ItemsControl
                            ItemsSource="{Binding MatchFilters}"
                            ItemTemplate="{StaticResource RoutingFilterTemplate}" />
                    </StackPanel>
                </Border>
                <ItemsControl
                    ItemsSource="{Binding ConstraintFilters}"
                    ItemTemplate="{StaticResource RoutingFilterTemplate}" />
                <Button
                    x:Name="btnAdd"
                    Click="AddSelector"
                    Content="+"
                    HorizontalAlignment="Center"
                    MinWidth="48"
                    Margin="0,12"
                    Padding="12,4"
                    AutomationProperties.Name="{x:Static resx:ResUI.RoutingBlocksAdd}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock
                Text="{Binding Error}"
                Foreground="IndianRed"
                TextWrapping="Wrap"
                Margin="0,0,0,6" />
            <TextBlock
                Text="{x:Static resx:ResUI.RoutingBlocksCompatibility}"
                TextWrapping="Wrap"
                Opacity="0.7"
                Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button
                    Content="{x:Static resx:ResUI.TbConfirm}"
                    Command="{Binding SaveCmd}"
                    IsDefault="True"
                    MinWidth="100"
                    Padding="12,6" />
                <Button
                    x:Name="btnCancel"
                    Content="{x:Static resx:ResUI.TbCancel}"
                    IsCancel="True"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Padding="12,6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
