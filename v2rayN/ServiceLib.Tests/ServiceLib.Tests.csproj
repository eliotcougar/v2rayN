<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <WinDivertTestArchitecture>x64</WinDivertTestArchitecture>
        <WinDivertTestArchitecture Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</WinDivertTestArchitecture>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="TUnit.Assertions.Should" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
    </ItemGroup>

    <!-- Packet fixtures use only the DLL's stateless checksum helper. No driver
         is copied, opened or loaded by the test host. -->
    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
        <Content Include="..\WinDivert\$(WinDivertTestArchitecture)\WinDivert.dll" Link="WinDivert.dll"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="TUnit.Assertions.Should" />
        <Using Include="TUnit.Assertions.Should.Extensions" />
    </ItemGroup>

</Project>
