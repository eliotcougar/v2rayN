<base:WindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    x:Class="v2rayN.Views.AppRoutingPackageWindow"
    x:TypeArguments="vms:AppRoutingPackageViewModel" Style="{StaticResource WindowGlobal}"
    Title="{x:Static resx:ResUI.AppRoutingWindowsApps}" Width="840" Height="680"
    MinWidth="620" MinHeight="520" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Account}" Margin="4,0,4,8" />
            <TextBlock Text="{x:Static resx:ResUI.AppRoutingPackageHelp}" TextWrapping="Wrap" Margin="4,0,4,12" />
            <StackPanel x:Name="NamePanel">
            <TextBlock Text="{x:Static resx:ResUI.AppRoutingRuleName}" Margin="4,0" />
            <TextBox x:Name="txtName" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4,4,4,8" Style="{StaticResource DefTextBox}"
                AutomationProperties.Name="{x:Static resx:ResUI.AppRoutingRuleName}" />
            </StackPanel>
            <TextBlock Text="{x:Static resx:ResUI.AppRoutingPackageSearch}" Margin="4,0" />
            <TextBox Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4,4" Style="{StaticResource DefTextBox}"
                AutomationProperties.Name="{x:Static resx:ResUI.AppRoutingPackageSearch}" />
            <WrapPanel Margin="0,4,0,8">
                <Button Content="{x:Static resx:ResUI.AppRoutingPackageImport}" Command="{Binding ImportCmd}" Margin="4" Padding="12,6" Style="{StaticResource DefButton}" />
                <Button Content="{x:Static resx:ResUI.AppRoutingSelectVisible}" Command="{Binding SelectVisibleCmd}" Margin="4" Padding="12,6" Style="{StaticResource DefButton}" />
                <Button Content="{x:Static resx:ResUI.AppRoutingClearVisible}" Command="{Binding ClearVisibleCmd}" Margin="4" Padding="12,6" Style="{StaticResource DefButton}" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <ItemsControl ItemsSource="{Binding Packages}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                            Height="56" Margin="4,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                            AutomationProperties.Name="{Binding Name}">
                            <StackPanel Margin="8,0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" Opacity="0.7" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="4,12,4,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="btnSave" Content="{x:Static resx:ResUI.TbConfirm}" IsEnabled="{Binding CanConfirm}" IsDefault="True" Margin="4,0" Padding="12,6" Style="{StaticResource DefButton}" />
                    <Button x:Name="btnCancel" Content="{x:Static resx:ResUI.TbCancel}" IsCancel="True" Margin="4,0,0,0" Padding="12,6" Style="{StaticResource DefButton}" />
                </StackPanel>
                <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Grid>
</base:WindowBase>
